{
  "name": "contrib-agent",
  "version": "0.1.0",
  "description": "Discover GitHub issues from your preferences and open draft PRs autonomously.",
  "type": "module",
  "bin": {
    "contrib-agent": "./cli/contrib-agent.ts"
  },
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "eval": "eve eval",
    "start": "eve start",
    "typecheck": "tsc",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning evals/*.test.ts",
    "contrib-agent": "node --experimental-strip-types --disable-warning=ExperimentalWarning cli/contrib-agent.ts",
    "discover": "node --experimental-strip-types --disable-warning=ExperimentalWarning cli/contrib-agent.ts discover --dry-run --fixture evals/fixtures/search-hits.json"
  },
  "dependencies": {
    "@vercel/connect": "1.0.0",
    "ai": "^7.0.93",
    "eve": "^0.56.0",
    "yaml": "^2.9.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
